{
  "name": "ecommerce-secure",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Yerel MySQL veya a\u00e7\u0131k demo modu ile g\u00fcvenlik odakl\u0131 e-ticaret demosu",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --coverage",
    "test:mysql": "node scripts/test-mysql.js",
    "db:init": "node scripts/db-init.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "csrf-sync": "^4.2.1",
    "bcryptjs": "^3.0.3",
    "mysql2": "^3.24.4",
    "dotenv": "^16.6.1",
    "winston": "^3.19.0",
    "cors": "^2.8.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/mysql/"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/server.js"
    ],
    "testTimeout": 15000
  }
}

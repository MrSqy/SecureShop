# Yerel demo. Bu örnek dosya Git tarafından izlenir; gerçek .env izlenmez.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_MOCK=true
# MySQL: docker compose up -d --wait; ardından DB_MOCK=false ve npm run db:init
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=secureshop
DB_USER=secureshop
DB_PASSWORD=local-demo-password
DB_TLS=false
DB_SSL_CA=
# Yerelde boşsa her başlangıçta rastgele üretilir, eski oturumlar kapanır.
SESSION_SECRET=
SESSION_TTL_MS=3600000
TRUST_PROXY_HOPS=0
# Yerelde loopback üzerinde aynı origin otomatik kabul edilir (port dahil).
ALLOWED_ORIGINS=
# Üretim altyapısı bu demo kapsamı dışındadır; bu istisnalar varsayılan kapalıdır.
ALLOW_LOCALHOST_DB_IN_PRODUCTION=false
ALLOW_MEMORY_STORE_IN_PRODUCTION=false
# development/test her zaman sahte gönderim kullanır; OTP yalnız development terminalinde.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_MOCK_SEND=false
WHATSAPP_TIMEOUT_MS=5000
# Canlı gönderim bu çalışmada doğrulanmadı. Sürümü güncel Meta belgelerinden seçin.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_PHONE_NUMBER=
# Boş: yalnız standart çıktı. Dolu: her biri 5 MB, en fazla 3 dosya.
LOG_DIR=

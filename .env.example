# Environment Variables — Güvenli Konfigürasyon
# ⚠️  Bu dosya .gitignore'da! Asla gerçek değerleri commit etme.

# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (RDS MySQL) ──────────────────────────────
# Development/test may use the local mock DB. Production requires real DB settings.
# Production refuses DB_MOCK=true and localhost DB hosts by default.
DB_MOCK=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=app_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Short-lived demos only; keep false for real production.
ALLOW_LOCALHOST_DB_IN_PRODUCTION=false

# ─── Session ──────────────────────────────────────────
# Production requires SESSION_SECRET with at least 32 characters.
SESSION_SECRET=CHANGE_ME_256_BIT_RANDOM_STRING
# Short-lived demos only; configure a real production session store instead.
ALLOW_MEMORY_STORE_IN_PRODUCTION=false

# ─── WhatsApp Notifications (Optional) ────────────────
# WhatsApp notifications are optional and disabled by default.
# Use Meta WhatsApp Cloud API credentials.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_PHONE_NUMBER=
WHATSAPP_MOCK_SEND=true

# ─── AWS (Production) ─────────────────────────────────
AWS_REGION=us-east-1
